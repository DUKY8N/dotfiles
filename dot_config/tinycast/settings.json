      "move-right": "ctrl+option+right",
      "move-up": "ctrl+option+up",
      "move-down": "ctrl+option+down",
      "move-to-left-edge": null,
      "move-to-right-edge": null,
      "move-to-top-edge": null,
      "move-to-bottom-edge": null,
      "next-display": "ctrl+option+,",
      "previous-display": "ctrl+option+.",
      "toggle-fullscreen": null,
