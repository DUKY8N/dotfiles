{
  "general": {
    "launcherShortcut": "hyper+space",
    "showInMenuBar": true,
    "automaticallyCheckForUpdates": true,
    "popToRootSeconds": 0,
    "escapeKeyBehavior": "navigateBackOrClose",
    "autoSwitchInputSource": "com.apple.keylayout.ABC",
    "supportReminders": true,
    "language": "ko"
  },
  "appearance": {
    "theme": "system",
    "animations": true,
    "interfaceSize": "standard",
    "compactMode": true,
    "compactBarCommands": [],
    "followCursorAcrossDisplays": true,
    "dragToReposition": false
  },
  "hyperKey": {
    "key": "capsLock",
    "includesShift": true,
    "quickPress": "originalKey",
    "secureInputCompatibility": false
  },
  "calculator": {
    "numberStyle": "system"
  },
  "search": {
    "showsSuggestions": true,
    "sensitivity": "medium"
  },
  "applications": {
    "enabled": true,
    "searchScopes": [
      "/Applications",
      "/Applications/Utilities",
      "/System/Applications",
      "/System/Applications/Utilities",
      "/System/Library/CoreServices/Applications",
      "/System/Volumes/Preboot/Cryptexes/App/System/Applications",
      "/System/Library/CoreServices/Finder.app",
      "~/Applications"
    ],
    "apps": {
      "com.anthropic.claudefordesktop": {
        "shortcut": "hyper+/",
        "alias": null,
        "showInLauncher": true
      },
      "com.mitchellh.ghostty": {
        "shortcut": "hyper+return",
        "alias": null,
        "showInLauncher": true
      },
      "com.openai.codex": {
        "shortcut": "hyper+.",
        "alias": null,
        "showInLauncher": true
      },
      "md.obsidian": {
        "shortcut": "hyper+o",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "systemSettings": {
    "enabled": true,
    "panes": {}
  },
  "systemActions": {
    "enabled": true,
    "actions": {
      "sleep": {
        "shortcut": "hyper+delete",
        "alias": null,
        "showInLauncher": true
      }
    }
  },
  "commands": {
    "builtInEnabled": true,
    "builtIn": {
      "define": {
        "shortcut": "hyper+d",
