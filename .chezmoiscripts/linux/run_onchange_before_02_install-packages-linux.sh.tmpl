#!/usr/bin/env bash
set -euo pipefail
{{- $wsl := .chezmoi.kernel.osrelease | lower | contains "microsoft" }}

# .pacmanfile hash: {{ include ".pacmanfile" | sha256sum }}
# .yayfile hash: {{ include ".yayfile" | sha256sum }}
{{- if not $wsl }}
# .pacmanfile-gui hash: {{ include ".pacmanfile-gui" | sha256sum }}
# .yayfile-gui hash: {{ include ".yayfile-gui" | sha256sum }}
{{- end }}

source_dir="{{ .chezmoi.sourceDir }}"
pacman_files=("$source_dir/.pacmanfile")
yay_files=("$source_dir/.yayfile")
{{- if not $wsl }}
# desktop packages, skipped on WSL
pacman_files+=("$source_dir/.pacmanfile-gui")
yay_files+=("$source_dir/.yayfile-gui")
{{- end }}

# one package per line; "#" starts a comment
read_packages() {
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$@"
}

printf "\nSyncing Pacman packages...\n"
mapfile -t pacman_pkgs < <(read_packages "${pacman_files[@]}")
sudo pacman -S --needed "${pacman_pkgs[@]}"

printf "\nSyncing AUR packages...\n"
mapfile -t aur_pkgs < <(read_packages "${yay_files[@]}")
if (( ${#aur_pkgs[@]} )); then
  yay -S --needed "${aur_pkgs[@]}"
fi
