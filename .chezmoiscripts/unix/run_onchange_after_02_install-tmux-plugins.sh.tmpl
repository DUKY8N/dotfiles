#!/usr/bin/env bash
set -euo pipefail

# tmux.conf hash: {{ include "dot_config/tmux/tmux.conf" | sha256sum }}

[[ -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

installer="$HOME/.config/tmux/plugins/tpm/bin/install_plugins"

command -v tmux >/dev/null || exit 0
[[ -x "$installer" ]] || exit 0

"$installer" || echo "tmux plugin install failed, run prefix + I inside tmux" >&2
