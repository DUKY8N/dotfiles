{{- $wsl := false -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if .chezmoi.kernel.osrelease | lower | contains "microsoft" -}}
{{-     $wsl = true -}}
{{-   end -}}
{{- end -}}
README.md

{{ if eq .chezmoi.os "windows" -}}
# Unix-like files - ignore on Windows
.zprofile
.zshenv
.zshrc
{{- end }}

{{ if ne .chezmoi.os "darwin" -}}
# macOS specific files - ignore on non-macOS systems
.hammerspoon/
.hushlogin
.chezmoiscripts/darwin/**
{{- end }}

{{ if ne .chezmoi.os "linux" -}}
# Linux specific files - ignore on non-Linux systems
.local/share/applications/
.chezmoiscripts/linux/**
{{- end }}

{{ if ne .chezmoi.os "windows" -}}
# Windows specific files - ignore on non-Windows systems
Documents/
.local/share/win-startup/
.chezmoiscripts/windows/**
{{- end }}

{{ if or (ne .chezmoi.os "linux") $wsl -}}
# Linux desktop scripts - ignore on non-Linux systems and on WSL
.chezmoiscripts/linux-desktop/**
{{- end }}
